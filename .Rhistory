scale_y_continuous(labels = scales::label_number(big.mark = ".", decimal.mark = ",")) +
theme_minimal() +
labs(title = "Sazonalidade Anual - Tráfego Total", x = "Mês", y = "Volume Total")
dados_gts <- dados_diarios_tratados %>%
aggregate_key(KM * Sentido * Tipo_Veiculo, Volume = sum(Volume, na.rm = TRUE))
dados_gts %>%
filter(!is_aggregated(Sentido), is_aggregated(KM), is_aggregated(Tipo_Veiculo)) %>%
autoplot(Volume) +
theme_minimal() +
scale_y_continuous(labels = scales::label_number(big.mark = ".", decimal.mark = ",")) +
labs(title = "Volume Diário de Veículos por Sentido (GTS)", x = "Data", y = "Volume Total")
dados_gts %>%
filter(is_aggregated(Sentido), is_aggregated(KM), !is_aggregated(Tipo_Veiculo)) %>%
autoplot(Volume) +
facet_wrap(~ Tipo_Veiculo, scales = "free_y") +
theme_minimal() +
scale_y_continuous(labels = scales::label_number(big.mark = ".", decimal.mark = ",")) +
theme(legend.position = "none") +
labs(title = "Volume Diário por Tipo de Veículo (GTS)", x = "Data", y = "Volume Total")
# 1. Separando Treino e Teste
dados_treino <- dados_gts %>% filter_index(. ~ "2025-07-31")
dados_teste <- dados_gts %>% filter_index("2025-08-01" ~ .)
# 2. Treinamento
modelos_treino <- dados_treino %>%
model(
ets = ETS(Volume),
arima = ARIMA(Volume),
stl_ets = decomposition_model(
STL(Volume ~ season(period = 7), robust = TRUE),
ETS(season_adjust ~ season("N"))
),
dhr = ARIMA(Volume ~ fourier(period = 7, K = 3) + PDQ(0,0,0))
) %>%
reconcile(
dhr_bu = bottom_up(dhr),
dhr_mint = min_trace(dhr, method = "mint_shrink")
)
# 3. Previsões
previsoes_teste <- modelos_treino %>% forecast(h = "122 days")
# 4. Avaliação de Acurácia
metricas_erro <- accuracy(previsoes_teste, dados_gts)
# 1. Separando Treino e Teste de forma Dinâmica
data_final_base <- max(dados_gts$Data)
data_corte_treino <- data_final_base - days(60) # Separa os últimos 2 meses para teste
dados_treino <- dados_gts %>% filter_index(. ~ as.character(data_corte_treino))
dados_teste <- dados_gts %>% filter_index(as.character(data_corte_treino + days(1)) ~ .)
# 2. Treinamento na base de Treino
modelos_treino <- dados_treino %>%
model(
ets = ETS(Volume),
arima = ARIMA(Volume),
stl_ets = decomposition_model(
STL(Volume ~ season(period = 7), robust = TRUE),
ETS(season_adjust ~ season("N"))
),
dhr = ARIMA(Volume ~ fourier(period = 7, K = 3) + PDQ(0,0,0))
) %>%
reconcile(
dhr_bu = bottom_up(dhr),
dhr_mint = min_trace(dhr, method = "mint_shrink")
)
# 3. Gerando as Previsões
# Como o teste tem 60 dias, o horizonte (h) da previsão deve ter 60 dias
previsoes_teste <- modelos_treino %>% forecast(h = "60 days")
# 4. Avaliação de Acurácia
metricas_erro <- accuracy(previsoes_teste, dados_gts)
# 3.2 Conversão Diária, Filtragem e Imputação
dados_diarios_tratados <- dados_ts %>%
filter(!KM %in% c("398", "842")) %>%
# CORTE RÍGIDO: Evita o erro de "150 dias missing"
filter_index("2021-01-01" ~ "2025-03-31") %>%
group_by_key() %>%
index_by(Data = as_date(Data_Hora)) %>%
# ... (resto do código de agrupamento e fill_gaps)
summarise(Volume = sum(Volume, na.rm = TRUE), .groups = "drop") %>%
# Revelar lacunas e Imputar com Mediana Sazonal
fill_gaps(Volume = NA) %>%
group_by_key() %>%
mutate(
Dia_Semana = wday(Data),
Volume_Tipico = median(Volume, na.rm = TRUE),
Volume = if_else(is.na(Volume), Volume_Tipico, Volume),
Volume = if_else(is.na(Volume), 0, Volume) # Fallback de segurança
) %>%
select(-Dia_Semana, -Volume_Tipico) %>%
ungroup()
