)
library(tidyverse)
library(fs)
library(readr)
library(lubridate)
library(tsibble)
library(fabletools)
library(feasts)
library(fable)
# ```{r validacao_modelos}
library(fabletools)
library(dplyr)
# 1. Separando Treino e Teste
# Treino: de Jan/2021 até Julho/2025
dados_treino <- dados_gts %>%
filter_index(. ~ "2025-07-31")
# Teste: de Agosto/2025 até Novembro/2025 (Apenas para conferência visual, se precisar)
dados_teste <- dados_gts %>%
filter_index("2025-08-01" ~ .)
# 2. Treinamento na base de Treino (O mesmo código que deu certo antes!)
modelos_treino <- dados_treino %>%
model(
ets = ETS(Volume),
arima = ARIMA(Volume),
stl_ets = decomposition_model(
STL(Volume ~ season(period = 7), robust = TRUE),
ETS(season_adjust ~ season("N"))
),
dhr = ARIMA(Volume ~ fourier(period = 7, K = 3) + PDQ(0,0,0))
) %>%
reconcile(
dhr_bu = bottom_up(dhr),
dhr_mint = min_trace(dhr, method = "mint_shrink")
)
# 3. Gerando as Previsões (Forecast)
# Agosto a Novembro totalizam cerca de 122 dias
previsoes_teste <- modelos_treino %>%
forecast(h = "122 days")
# 4. Calculando as Métricas de Erro
# Cruzamos as previsões com a base original (dados_gts)
metricas_erro <- accuracy(previsoes_teste, dados_gts)
# ```
library(tidyverse)
library(fs)
library(readr)
library(lubridate)
library(tsibble)
library(fabletools)
library(feasts)
library(fable)
# Limpeza, Extração e Transformação Definitiva
dados_limpos <- dados_brutos %>%
# Remover a coluna 'Faixa'
select(-any_of(c("faixa", "Faixa", "FAIXA"))) %>%
# Extrair metadados do nome do arquivo
mutate(nome_arquivo = basename(caminho_arquivo)) %>%
mutate(nome_arquivo = str_remove(nome_arquivo, "\\.csv")) %>%
separate(
col = nome_arquivo,
into = c("BR", "Estado", "KM", "Ano_Arquivo"),
sep = "_",
extra = "drop"
) %>%
mutate(KM = str_remove(KM, "km")) %>%
# Remover a coluna auxiliar de caminho
select(-caminho_arquivo) %>%
# Tratar a Data
mutate(Data = dmy(Data)) %>%
# Pivotar as categorias de A até L
# Usamos as crases (`) porque os nomes das colunas têm espaços e parênteses
pivot_longer(
cols = `(A) Ônibus/Caminhão de 2 eixos`:`(L) Indefinido`,
names_to = "Tipo_Veiculo",
values_to = "Volume"
) %>%
# Opcional: Limpar o nome do Tipo de Veículo para deixar só a letra
# Isso facilita muito na hora de montar a hierarquia!
mutate(Tipo_Veiculo = str_extract(Tipo_Veiculo, "(?<=\\()[A-Z](?=\\))"))
# Preparar os dados para plotagem
# Filtrar o período e agregar por Mês ao invés de dia para que os gráficos fiquem legíveis e renderizem rápido (mais de 43800 pontos por linha ao renderizar por dia)
dados_viz <- dados_ts %>%
filter_index("2021-01-01" ~ "2025-12-31") %>%
# Agrupa pelo cruzamento das chaves atuais, mas muda o índice para Mensal
group_by_key() %>%
index_by(Mes = ~ yearmonth(.)) %>%
# Soma o volume horário para obter o volume total mensal
summarise(Volume = sum(Volume, na.rm = TRUE), .groups = "drop")
# 1. Salvar o resultado na variável 'tabela_lacunas'
tabela_lacunas <- dados_viz %>%
as_tibble() %>%
group_by(KM, Mes) %>%
summarise(Volume_Total = sum(Volume, na.rm = TRUE), .groups = "drop") %>%
as_tsibble(index = Mes, key = KM) %>%
count_gaps()
# 1. Revelar lacunas e Imputar os dados
dados_diarios_imputados <- dados_diarios %>%
# Revela os buracos ocultos no calendário, colocando NA na coluna Volume
fill_gaps(Volume = NA) %>%
# Tranca a hierarquia para que a média de um KM/Veículo não contamine outro
group_by_key() %>%
mutate(
# Descobre o dia da semana (1 = Domingo, 7 = Sábado)
Dia_Semana = wday(Data),
# Calcula o volume típico daquele dia da semana (ignorando os NAs)
Volume_Tipico = median(Volume, na.rm = TRUE),
# Se o Volume for NA, usa o Volume_Tipico. Se não for, mantém o original.
Volume = if_else(is.na(Volume), Volume_Tipico, Volume)
) %>%
# Limpa as colunas auxiliares que criamos
select(-Dia_Semana, -Volume_Tipico) %>%
ungroup()
# Fallback de segurança: Se uma categoria inteira for vazia, a mediana
# retornará NA. Garantimos que qualquer NA restante vire 0.
dados_diarios_imputados <- dados_diarios_imputados %>%
mutate(Volume = if_else(is.na(Volume), 0, Volume))
# 2. Recriando a Grouped Time Series (GTS) com os dados sem buracos
dados_gts <- dados_diarios_imputados %>%
aggregate_key(
KM * Sentido * Tipo_Veiculo,
Volume = sum(Volume, na.rm = TRUE)
)
# Soma de todos os KMs, Sentidos e Tipos
dados_viz %>%
summarise(Volume_Total = sum(Volume, na.rm = TRUE)) %>%
ggplot(aes(x = Mes, y = Volume_Total)) +
geom_line(color = "darkblue", linewidth = 1) +
theme_minimal() +
scale_y_continuous(labels = scales::comma) + # Evita notação científica
labs(
title = "Volume Total Mensal - BR-381",
subtitle = "Período: 2021 a 2025",
x = "Mês",
y = "Volume Total de Veículos"
)
dados_diarios <- dados_ts %>%
filter_index("2021-01-01" ~ .) %>%
group_by_key() %>%
# 3. Agrupa o tempo por Dia (muda o índice de Data_Hora para Data)
index_by(Data = as_date(Data_Hora)) %>%
summarise(Volume = sum(Volume, na.rm = TRUE), .groups = "drop")
dados_diarios
