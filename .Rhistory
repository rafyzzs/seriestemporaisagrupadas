# Preparando base agregada mensal para visualização
dados_viz <- dados_diarios_tratados %>%
group_by_key() %>%
index_by(Mes = ~ yearmonth(.)) %>%
summarise(Volume = sum(Volume, na.rm = TRUE), .groups = "drop")
dados_viz %>%
summarise(Volume_Total = sum(Volume, na.rm = TRUE)) %>%
ggplot(aes(x = Mes, y = Volume_Total)) +
geom_line(color = "darkblue", linewidth = 1) +
theme_minimal() +
scale_y_continuous(labels = scales::comma) +
labs(title = "Volume Total Mensal - BR-381", x = "Mês", y = "Volume Total")
dados_viz %>%
group_by(Sentido) %>%
summarise(Volume = sum(Volume, na.rm = TRUE)) %>%
ggplot(aes(x = Mes, y = Volume, color = Sentido)) +
geom_line(linewidth = 1) +
theme_minimal() +
scale_y_continuous(labels = scales::comma) +
labs(title = "Volume Mensal por Sentido de Via", x = "Mês", y = "Volume")
View(dados_viz)
dados_limpos %>%
# Foca apenas nos 7 KMs saudáveis
filter(!KM %in% c("398", "842")) %>%
