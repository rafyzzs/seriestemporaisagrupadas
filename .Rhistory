salvar_log_experimento <- function(metricas, arquivo_log, tipo_modelo, p_init, p_step, p_h) {
library(readr)
library(dplyr)
# Adiciona os parâmetros do teste como novas colunas nas métricas geradas
log_atual <- metricas |>
mutate(
data_execucao = Sys.time(),
tipo_modelagem = tipo_modelo, # Ex: "Diária - STL", "Horária - ARIMA"
param_init = p_init,
param_step = p_step,
param_h = p_h
) |>
# Reorganiza para as informações do teste ficarem nas primeiras colunas
relocate(data_execucao, tipo_modelagem, param_init, param_step, param_h)
# Se o arquivo já existir, ele anexa embaixo. Se não, cria um novo com cabeçalho.
write_csv(log_atual, arquivo_log, append = file.exists(arquivo_log))
cat("Experimento salvo com sucesso em:", arquivo_log, "\n")
}
