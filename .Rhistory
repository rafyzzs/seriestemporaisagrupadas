dados_diarios_imputados <- dados_diarios %>%
# Revela os buracos ocultos no calendário, colocando NA na coluna Volume
fill_gaps(Volume = NA) %>%
# Tranca a hierarquia para que a média de um KM/Veículo não contamine outro
group_by_key() %>%
mutate(
# Descobre o dia da semana (1 = Domingo, 7 = Sábado)
Dia_Semana = wday(Data),
# Calcula o volume típico daquele dia da semana (ignorando os NAs)
Volume_Tipico = median(Volume, na.rm = TRUE),
# Se o Volume for NA, usa o Volume_Tipico. Se não for, mantém o original.
Volume = if_else(is.na(Volume), Volume_Tipico, Volume)
) %>%
# Limpa as colunas auxiliares que criamos
select(-Dia_Semana, -Volume_Tipico) %>%
ungroup()
# Fallback de segurança: Se uma categoria inteira for vazia, a mediana
# retornará NA. Garantimos que qualquer NA restante vire 0.
dados_diarios_imputados <- dados_diarios_imputados %>%
